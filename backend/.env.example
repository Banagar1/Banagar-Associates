# =========================================================================
# BANAGAR ASSOCIATES - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# File: backend/.env.example
# =========================================================================

# --- DATABASE CONFIGURATION ---
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/banagar_db

# --- SECURITY & JWT AUTHORIZATION ---
JWT_SECRET=your_jwt_secret_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=12

# --- ADMIN USER CREDENTIALS ---
ADMIN_EMAIL=admin@banagar.com
ADMIN_PASSWORD_HASH=insert_your_bcrypt_hash_here
ADMIN_PHONE=+919945899909

# --- SMTP GMAIL NOTIFICATION GATEWAY ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password

# --- SMS GATEWAY CONFIGURATION (OPTIONAL) ---
SMS_API_URL=https://api.sms-gateway.com/send
SMS_API_KEY=your_sms_api_key_here